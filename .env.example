# Wajib production
SECRET_KEY=ganti-dengan-random-minimal-32-karakter
SETTINGS_ENCRYPTION_KEY=ganti-dengan-random-terpisah-minimal-32-karakter
DATABASE_URL=postgresql://user:password@host:5432/database
SITE_URL=https://domain-anda.com
RENDER=true

# Buat Super Admin pertama hanya saat menjalankan seed secara eksplisit
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=ganti-password-kuat-minimal-12-karakter

# Panel rahasia
ADMIN_PANEL_PATH=/panel-admin-rahasia-ganti
SUPER_ADMIN_PANEL_PATH=/panel-superadmin-rahasia-ganti

# Session & keamanan
SESSION_COOKIE_SECURE=1
SESSION_DAYS=7
WTF_CSRF_SSL_STRICT=1
RATELIMIT_STORAGE_URI=redis://localhost:6379/0
LOG_LEVEL=INFO
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
AUTO_CREATE_DB=0
AUTO_SEED_DB=0
MAX_CONTENT_LENGTH=5242880

# Media Cloudinary
MEDIA_STORAGE_BACKEND=cloudinary
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rajatopupgames

# Email reset password
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USE_SSL=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
PASSWORD_RESET_MAX_AGE=3600

# Notifikasi Telegram opsional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
